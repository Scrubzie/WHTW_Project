QWidget {
    background-color: #111B27;
}

QMainWindow {
    background-color: #080B10;
}

QPushButton {
    background-color: #34465F;
    color: #E2E8F0;
    border: none;
    border-radius: 6px;
    padding: 12px;
    text-align: left;
}

QPushButton:hover {
    background-color: #475B75;
}

QPushButton[active="true"] {
    background-color: #2563EB;
    color: white;
    font-weight: bold;
}

/* Left sidebar */
#sidebar {
    background-color: #111B27;
    border-right: 1px solid #26384b;
}

/* Main content */
#content {
    background-color: #080B10;
}

#version {
    color: #94A3B8;
    font-size: 9px;
}

#logo {
    font-size: 15px;
    font-weight: bold;
    color: #60A5FA;
}

#footer {
    color: #64748B;
    font-size: 9px;
}

#ship_database {
    color: #080e16;
}

#ship_dossier_panel_background {
    background-color: #111c29;
    border: 1px solid #26384b;
    border-radius: 6px;
}

#ship_list_panel_background {
    background-color: #111c29;
    border: 1px solid #26384b;
    border-radius: 6px;
}